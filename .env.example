# Compose reads .env. Local Python: export variables or use uvicorn --env-file .env.
DATABASE_URL=sqlite:///./identitytrace.db
# Loopback development only. Never enable demo mode for remote use.
IDENTITYTRACE_DEMO_MODE=1
# Docker Compose reads password and credentials from files.
IDENTITYTRACE_DB_PASSWORD_FILE=./secrets/db-password.txt
IDENTITYTRACE_CREDENTIALS_FILE=./secrets/credentials.json
# Production: unset demo mode, migrate PostgreSQL and configure your provider.
# IDENTITYTRACE_ENV=production
# IDENTITYTRACE_OIDC_ISSUER=https://login.microsoftonline.com/YOUR-TENANT-ID/v2.0
# IDENTITYTRACE_OIDC_AUDIENCE=YOUR-API-APPLICATION-ID
# IDENTITYTRACE_OIDC_JWKS_URL=https://login.microsoftonline.com/YOUR-TENANT-ID/discovery/v2.0/keys
# IDENTITYTRACE_ORGANIZATION_ID=YOUR-TENANT-ID
# IDENTITYTRACE_OIDC_ORG_CLAIM=tid
# IDENTITYTRACE_OIDC_ROLES_CLAIM=roles
# IDENTITYTRACE_OIDC_ROLE_MAP={"IdentityTrace.Viewer":"viewer","IdentityTrace.Analyst":"analyst","IdentityTrace.Ingestor":"ingestor","IdentityTrace.Admin":"admin"}
# Optional browser sign-in (use scripts/onboard_customer.py for a complete Compose bundle).
# IDENTITYTRACE_OIDC_CLIENT_ID=YOUR-SEPARATE-WEB-CLIENT-ID
# IDENTITYTRACE_OIDC_CLIENT_SECRET_FILE=./secrets/client-secret.txt
# IDENTITYTRACE_SESSION_SECRET_FILE=./secrets/session-secret.txt
# IDENTITYTRACE_PUBLIC_URL=https://YOUR-HOST
# IDENTITYTRACE_OIDC_AUTHORIZE_URL=https://login.microsoftonline.com/YOUR-TENANT-ID/oauth2/v2.0/authorize
# IDENTITYTRACE_OIDC_TOKEN_URL=https://login.microsoftonline.com/YOUR-TENANT-ID/oauth2/v2.0/token
# IDENTITYTRACE_OIDC_SCOPE=openid profile api://YOUR-API-APPLICATION-ID/access_as_user
# IDENTITYTRACE_OIDC_SUBJECT_CLAIM=oid
